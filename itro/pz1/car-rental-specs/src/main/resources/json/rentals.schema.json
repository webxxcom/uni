{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://nure.ua/knt-23-1/kravchenko/car-rental/rentals.schema.json",
  "title": "Список оренд (Rental Service)",
  "description": "Відповідь Rental Service: оренди з вкладеними автомобілем, моделлю, клієнтом, додатковими послугами та оплатою.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "source", "rentals"],
  "properties": {
    "generatedAt": {
      "description": "Момент формування документа (ISO 8601).",
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "description": "Підсистема-відправник.",
      "type": "string",
      "enum": ["FLEET_SERVICE", "CUSTOMER_SERVICE", "RENTAL_SERVICE"]
    },
    "rentals": {
      "description": "Оренди.",
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/rental" }
    }
  },
  "$defs": {
    "money": {
      "description": "Грошова сума в гривнях: більше 0, не більше 99999.99.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 99999.99
    },
    "plateNumber": {
      "description": "Український номерний знак, напр. AX1234BC.",
      "type": "string",
      "minLength": 8,
      "maxLength": 8,
      "pattern": "^[ABCEHIKMOPTX]{2}[0-9]{4}[ABCEHIKMOPTX]{2}$"
    },
    "nonBlankName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^(?!\\s*$).+"
    },
    "rental": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "startDate", "endDate", "car", "customer", "extras", "totalCost", "payment"],
      "properties": {
        "id": {
          "description": "Номер оренди (6 цифр).",
          "type": "integer",
          "minimum": 100000,
          "maximum": 999999
        },
        "status": {
          "type": "string",
          "enum": ["BOOKED", "ACTIVE", "COMPLETED", "CANCELLED"]
        },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "car": { "$ref": "#/$defs/car" },
        "customer": { "$ref": "#/$defs/customer" },
        "extras": {
          "description": "Додаткові послуги; кожна послуга не більше одного разу.",
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/extra" }
        },
        "totalCost": { "$ref": "#/$defs/money" },
        "payment": { "$ref": "#/$defs/payment" }
      }
    },
    "carModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "brand", "name", "year", "engineType", "transmission", "seats", "dailyRate"],
      "properties": {
        "id": { "type": "string", "pattern": "^M[0-9]{3}$" },
        "brand": { "type": "string", "minLength": 1, "maxLength": 50 },
        "name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "year": {
          "description": "Рік моделі: від 2000 включно до 2028 не включно.",
          "type": "integer",
          "minimum": 2000,
          "exclusiveMaximum": 2028
        },
        "engineType": { "type": "string", "enum": ["PETROL", "DIESEL", "ELECTRIC", "HYBRID"] },
        "transmission": { "type": "string", "enum": ["MANUAL", "AUTOMATIC"] },
        "seats": { "type": "integer", "minimum": 2, "maximum": 9 },
        "dailyRate": { "$ref": "#/$defs/money" }
      }
    },
    "car": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plateNumber", "color", "mileage", "status", "model"],
      "properties": {
        "plateNumber": { "$ref": "#/$defs/plateNumber" },
        "color": { "type": "string", "minLength": 3, "maxLength": 30 },
        "mileage": { "type": "integer", "minimum": 0, "maximum": 999999 },
        "status": { "type": "string", "enum": ["AVAILABLE", "RENTED", "MAINTENANCE"] },
        "model": { "$ref": "#/$defs/carModel" }
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "firstName", "lastName", "phoneNumber", "birthDate", "driverLicense"],
      "properties": {
        "id": { "type": "string", "pattern": "^C[0-9]{4}$" },
        "firstName": { "$ref": "#/$defs/nonBlankName" },
        "lastName": { "$ref": "#/$defs/nonBlankName" },
        "phoneNumber": {
          "description": "Український мобільний номер з 10 цифр, починається з 0.",
          "type": "string",
          "pattern": "^0[0-9]{9}$"
        },
        "email": {
          "description": "Необов'язкове поле; може бути null, якщо клієнт не вказав e-mail.",
          "type": ["string", "null"],
          "format": "email",
          "maxLength": 100
        },
        "birthDate": { "type": "string", "format": "date" },
        "driverLicense": { "type": "string", "pattern": "^[A-Z]{3}[0-9]{6}$" },
        "discountPercent": {
          "description": "Персональна знижка 0..30 %; поле необов'язкове.",
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "price"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["CHILD_SEAT", "GPS", "FULL_INSURANCE", "ADDITIONAL_DRIVER", "SNOW_CHAINS"]
        },
        "price": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1000
        }
      }
    },
    "payment": {
      "description": "Оплата: рівно один із варіантів – карткою, готівкою або очікує оплати.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "maskedNumber", "paidAt"],
          "properties": {
            "method": { "const": "CARD" },
            "maskedNumber": { "type": "string", "pattern": "^\\*{4} \\*{4} \\*{4} [0-9]{4}$" },
            "paidAt": { "type": "string", "format": "date-time" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "receiptNumber", "paidAt"],
          "properties": {
            "method": { "const": "CASH" },
            "receiptNumber": { "type": "string", "pattern": "^RC-[0-9]{6}$" },
            "paidAt": { "type": "string", "format": "date-time" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "dueDate"],
          "properties": {
            "method": { "const": "PENDING" },
            "dueDate": { "type": "string", "format": "date" }
          }
        }
      ]
    }
  }
}
